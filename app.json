{
  "expo": {
    "name": "Fre Haymanot",
    "version": "1.0.0",
    "scheme": "frehaymanot",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "cover"
        }
      ],
      ["expo-router"],
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.besukal12.frehaymanot"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1db0047-62c5-4af8-8a1f-68d957904831"
      }
    }
  }
}
